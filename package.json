{
  "name": "perch-maker-console",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "U 本位 Maker 移动网格模拟与风控工作台",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:live": "node --import tsx/esm scripts/test-live.mjs",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsx": "^4.20.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  }
}
