# Copy this file to .env.local in the project root. Never share the filled file.
# This application is a U-margined perpetual maker workspace. By default it runs
# in paper mode. Live trading is opt-in and only enabled after .env is filled
# and the operator confirms the live-mode switch in the UI.
PORT=4318

# ============================================================
# Market data (read-only)
# ============================================================
# demo: https://demo-fapi.binance.com
# production: https://fapi.binance.com
BINANCE_READONLY_ENV=demo

# Optional: HMAC API key with read-only permissions.
BINANCE_READONLY_API_KEY=
BINANCE_READONLY_API_SECRET=

# ============================================================
# Live trading (POST /api/execution/mode { mode: "live" })
# ============================================================
# When the operator confirms the live switch, the workbench will:
#   1. Cancel every robot's resting orders
#   2. Synchronise the clock and pull /fapi/v3/account
#   3. Start placing Post-only GTX limit orders via HMAC-signed requests
#   4. Reconcile open orders, positions, fills from /fapi/v1/*
# Demo env is the default for safe dry-runs; switch to production for real funds.
# Required permissions on the key: Enable Trading, Enable Margin, IP restriction.
BINANCE_LIVE_ENV=demo
# 也可以在页面「使用指南 → 启用实盘交易」里直接填写 Key/Secret，保存到本机 data/live-credentials.json，就无需在此填。
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=